# Local-development values only. For production, generate a random key with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Local dev needs nothing here — leave DATABASE_URL unset and Django uses
# SQLite (db.sqlite3 in this folder) automatically. Uncomment the line below
# only once you have a real Postgres server to point at (see README.md).
# DATABASE_URL=postgres://localoffers:localoffers@localhost:5432/localoffers

TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Celery/Redis are optional for local dev — offer scheduling/expiry just
# won't run on a timer without them (see README.md "Running Celery").
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
DB_CONN_MAX_AGE=60
PUBLIC_API_CACHE_SECONDS=15
API_ANON_RATE=120/minute
API_USER_RATE=600/minute
OTP_REQUEST_RATE=3/minute
OTP_VERIFY_RATE=10/minute
DRF_NUM_PROXIES=1

FRONTEND_URL=http://localhost:5173

# Production: set any installed Django storage backend and its provider-specific options.
# MEDIA_STORAGE_BACKEND=your_storage_package.backends.PrivateMediaStorage
# MEDIA_STORAGE_OPTIONS='{"container_name":"localoffers-media"}'
# Install the selected backend/SDK and supply credentials through workload identity or a secret manager.
# S3-compatible storage is one option, not a requirement.

# Production: callable accepting (phone_number, message), provided by your SMS adapter.
# Example: SMS_BACKEND=your_project.sms.send_sms
# Development defaults to the console sink; it is refused in production.
